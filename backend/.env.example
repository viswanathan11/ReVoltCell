# Server Config
PORT=3000
HOST=0.0.0.0

# Database URL
# For SQLite (default, zero configuration):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (if running PostgreSQL or Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revoltcell?schema=public"

# CORS & URLs
CORS_ORIGIN="http://localhost:5173"
API_BASE_URL="http://localhost:3000"
PASSPORT_BASE_URL="http://localhost:5173/passport"

# VoltIQ AI Chatbot Configuration
# Supported providers: gemini | openai | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
# Server-side API key (Never commit real keys or expose in frontend bundles)
LLM_API_KEY=your_gemini_api_key_here
LLM_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=1000
AI_MAX_OUTPUT_TOKENS=800
AI_RATE_LIMIT_PER_MINUTE=30
